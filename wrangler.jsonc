{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "downfiles",
  "compatibility_date": "2026-07-22",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "exclude": [
      "node_modules/**",
      ".git/**",
      ".vercel/**",
      "server/**"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
